# Backend runtime (copy to .env; never commit secrets)
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/kept?schema=public
DEVNET_RPC_URL=https://api.devnet.solana.com
KEEPER_PROGRAM_ID=7VpBDwXiDvvaG29VBFUPankoSWFVanyD9KcT7wbmLVzj
SESSION_SECRET=replace-with-at-least-32-random-bytes
VERIFIER_SECRET_KEY=[64-byte Solana keypair JSON]
FAUCET_SECRET_KEY=[64-byte Solana keypair JSON]
STAKE_MINT=
# SPL token account for the treasury; `npm run v4:setup` prints this ATA.
TREASURY_TOKEN_ACCOUNT=
# Wallet that owns the treasury ATA. Used by v4:setup, not read by the backend.
TREASURY_OWNER=52eWttmzYBJn4awLjEMB42bw5oTFvL4XC1gDqFAQgPxJ
# For local prototype testing only; restrict to tester wallets.
SGT_MOCK=true
SGT_MOCK_ALLOWLIST=WalletPublicKey1,WalletPublicKey2
# Token-2022 group address for real Genesis-token membership validation.
GENESIS_GROUP=
# Use persistent private storage; oath photos are removed after settlement.
PROOF_STORAGE_DIR=/var/lib/kept/proofs
# JSON service account object for Firebase Cloud Messaging HTTP v1.
FCM_SERVICE_ACCOUNT_JSON=
# Long random secret for POST /admin/run-jobs (x-admin-secret header). Unset disables admin routes.
ADMIN_SECRET=
# Wallet that pays bounty pools: "faucet" (FAUCET_SECRET_KEY, default) or "verifier" (VERIFIER_SECRET_KEY).
BOUNTY_PAYER=faucet
# The Keeper's server-side photo check (POST /proof/verify): an OpenAI-compatible vision endpoint.
# Server-side only; never put this key in the app. Without it, photo checks answer 503 check_unavailable.
OPEN_API_KEY=
# Endpoint and model (any OpenAI-compatible vision chat model):
VISION_API_URL=https://openrouter.ai/api/v1/chat/completions
VISION_MODEL=google/gemma-3-27b-it
VISION_TIMEOUT_MS=25000
# Default minutes between the start and end proof photo (an Oath creator or bounty admin can set their own).
SESSION_MIN_MINUTES=30
# The Keeper's voice (ElevenLabs): key with Text to Speech, Voice Generation, Voices read+write.
# Design the voice once with scripts/keeper_voice_design.ts and put the printed id in KEEPER_VOICE_ID.
ELEVENLABS_API_KEY=
KEEPER_VOICE_ID=
ELEVEN_TTS_MODEL=eleven_flash_v2_5
ELEVEN_STT_MODEL=scribe_v3
# "Ask the Keeper" answers: any chat model on the same OpenAI-compatible endpoint (defaults to VISION_MODEL).
ASK_MODEL=

# Supabase (optional). Storage: public copies of the Keeper receipts (bucket keeper-receipts, public read).
# The secret key (sb_secret_...) is server-side only. For Supabase Postgres, set DATABASE_URL to the pooler URL
# (port 6543, ?pgbouncer=true&connection_limit=1); run migrations over the session pooler (port 5432).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_RECEIPTS_BUCKET=keeper-receipts

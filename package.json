{
  "name": "kept",
  "private": true,
  "description": "KEPT monorepo: mobile app, API, Anchor program and shared packages",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "security:scan": "node scripts/check-secrets.cjs",
    "security:staged": "node scripts/check-secrets.cjs --staged",
    "security:test": "node --test scripts/security.test.cjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "api:dev": "pnpm --filter kept-backend dev",
    "api:test": "pnpm --filter kept-backend test",
    "mobile:start": "pnpm --filter @kept/mobile start",
    "mobile:android": "pnpm --filter @kept/mobile android",
    "theme:gen": "pnpm --filter @kept/mobile theme:gen",
    "idl:sync": "pnpm --filter @kept/chain idl:sync",
    "program:build": "pnpm --filter @kept/program build",
    "program:test": "pnpm --filter @kept/program test:all",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}

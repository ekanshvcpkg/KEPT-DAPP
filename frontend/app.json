{
  "expo": {
    "name": "KEPT",
    "slug": "kept",
    "scheme": "kept",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/brand/kept-app-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131313",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "app.kept.mobile",
      "versionCode": 10401,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kept-keeper.vercel.app",
              "pathPrefix": "/o/"
            },
            {
              "scheme": "https",
              "host": "keptdapp.vercel.app",
              "pathPrefix": "/o/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/kept-app-icon.png",
          "imageWidth": 112,
          "backgroundColor": "#131313"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "KEPT uses the camera for your two daily proof photos and to scan invite QR codes.",
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true,
            "extraProguardRules": "# Mobile Wallet Adapter: kept whole, its wallet round trip can only be tested on a phone.\n-keep class com.solana.** { *; }\n-keep class com.solanamobile.** { *; }\n# MediaPipe tasks (rep counter pose landmarker): its JNI layer looks up Java classes and protobuf fields by name.\n-keep class com.google.mediapipe.** { *; }\n-keep class com.google.protobuf.** { *; }\n-dontwarn com.google.mediapipe.**\n-dontwarn com.google.protobuf.**\n# CameraX (rep counter's own camera) and the kept-gesture module.\n-keep class androidx.camera.** { *; }\n-keep class expo.modules.keptgesture.** { *; }"
          }
        }
      ],
      "expo-secure-store",
      "./plugins/withReleaseSigning",
      "./plugins/withDevMenuNoFab",
      [
        "expo-audio",
        {
          "microphonePermission": "KEPT uses the microphone only while you hold the Keeper button to ask it a question.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}

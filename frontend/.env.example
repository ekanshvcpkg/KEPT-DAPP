# Copy to .env (Expo inlines EXPO_PUBLIC_* when Metro bundles the JS: restart Metro with --clear after a
# change. A development build needs no native rebuild for these; a release APK embeds them, so rebuild it.)
# There is no API mode setting: Demo is always the mock, Live is always the real backend + wallet (D-80).
# Hosted Devnet backend. Override with http://localhost:3000 only for intentional local API work.
EXPO_PUBLIC_API_URL=https://kept-api-vxk8.onrender.com
EXPO_PUBLIC_CLUSTER=devnet
EXPO_PUBLIC_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_PROGRAM_ID=7VpBDwXiDvvaG29VBFUPankoSWFVanyD9KcT7wbmLVzj
# The SPL stake mint of the program's Config (the hosted Devnet one below). Don't leave it empty: an empty line
# overrides the built-in default with nothing.
EXPO_PUBLIC_STAKE_MINT=CDGRQc6aj7r6Kk41gvzeH2ta7vzL5rAXeogLJm7nkSqu
# Live Oaths stake native SOL (the hosted API and program support it). 0 turns them off.
EXPO_PUBLIC_LIVE_NATIVE_SOL_OATHS=1
EXPO_PUBLIC_APP_IDENTITY_NAME=KEPT
EXPO_PUBLIC_APP_IDENTITY_URI=https://keptdapp.vercel.app
# 1 only when that site's /.well-known/assetlinks.json grants delegate_permission/common.get_login_creds to app.kept.mobile
# (Phantom declines silent re-authorization otherwise).
EXPO_PUBLIC_APP_IDENTITY_VERIFIED=0
# 86400 normally. 120 only against a program built with the debug-tools feature (2-minute days for testing).
EXPO_PUBLIC_DAY_SECONDS=86400
# Supabase project URL: Audit the Keeper reads the public receipts there first. Empty = the hosted project (built-in default).
EXPO_PUBLIC_SUPABASE_URL=
# Supabase publishable key (public): live Oath updates over Supabase Realtime. Empty = the hosted project's (built-in default).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

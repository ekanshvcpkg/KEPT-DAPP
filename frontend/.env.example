# Copy to .env (Expo inlines EXPO_PUBLIC_* when Metro bundles the JS: restart Metro with --clear after a
# change. A development build needs no native rebuild for these; a release APK embeds them, so rebuild it.)
# There is no API mode setting: Demo is always the mock, Live is always the real backend + wallet (D-80).
# Hosted Devnet backend. Override with http://localhost:3000 only for intentional local API work.
EXPO_PUBLIC_API_URL=https://kepttestapp.onrender.com
EXPO_PUBLIC_CLUSTER=devnet
EXPO_PUBLIC_RPC_URL=https://api.devnet.solana.com
EXPO_PUBLIC_PROGRAM_ID=6iXXBqsdiCnUTSVf8CW3Uuw8c7iYvZSj5haz64QMuMUh
# The SKR mint printed by `pnpm --filter kept-backend exec tsx scripts/v4-setup.ts` (STAKE_MINT).
EXPO_PUBLIC_STAKE_MINT=
# Keep Live native-SOL Oaths off until the matching API and program are deployed and verified.
EXPO_PUBLIC_LIVE_NATIVE_SOL_OATHS=0
EXPO_PUBLIC_APP_IDENTITY_NAME=KEPT
EXPO_PUBLIC_APP_IDENTITY_URI=https://keptdapp.vercel.app
# 86400 normally. 120 only against a program built with the debug-tools feature (2-minute days for testing).
EXPO_PUBLIC_DAY_SECONDS=86400
